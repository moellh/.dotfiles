# ~/.config/systemd is a directory link into this repo, so `systemctl --user enable` and
# machine-specific drop-ins land here. Which units to enable is in system/services.txt.
config/.config/systemd/user/*.wants/
config/.config/systemd/user/syncthing.service.d/

.gemini/
gha-creds-*.json
