# Google Gemma 4 E4B, unsloth QAT UD-Q4_K_XL (spring 2026) - lowest RAM use; text only (no mmproj).
# Sampling per the model card. Needs fit target 512 (128 OOMs on Vulkan compute buffers).
LLAMA_MODEL=models/gemma-4-e4b/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
LLAMA_HF_REPO=unsloth/gemma-4-E4B-it-qat-GGUF
LLAMA_HF_FILE=gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
LLAMA_MODEL_ALIAS=gemma-4-e4b
LLAMA_FIT_TARGET=512
LLAMA_REASONING=off
LLAMA_TEMPERATURE=1.0
LLAMA_TOP_K=64
LLAMA_TOP_P=0.95
LLAMA_MIN_P=0.0
LLAMA_PRESENCE_PENALTY=0.0
LLAMA_REPEAT_PENALTY=1.0
