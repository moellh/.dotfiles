// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "bottom",
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces",
        "wlr/taskbar",
        "hyprland/window",
    ],

    "modules-center": [ ],

    "modules-right": [
        // "custom/tps",
        "network",
        "custom/bridge",
        "custom/sshd",
        "cpu",
        "custom/gpu",
        "memory",
        "bluetooth",
        "pulseaudio",
        "battery",
        "hyprland/language",
        "tray",
        "clock",
    ],

    "custom/bridge": {
        "format": "{}",
        "exec": "/home/henrikmoellmann/.local/bin/bridge-ctl waybar",
        "interval": 10,
        "return-type": "json",
        "signal": 1,
        "hide-empty-text": true,
        "on-click": "/home/henrikmoellmann/.local/bin/bridge-ctl toggle",
    },

    "custom/sshd": {
        "format": "{}",
        "exec": "if systemctl is-active --quiet sshd.service; then printf S; fi",
        "interval": 10,
        "hide-empty-text": true,
        "tooltip": false,
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": false,
        "all-outputs": true,
        "warp-on-scroll": false,
        // "persistent-workspaces": {
        //     "DP-1": [1, 2, 3, 4, 5]
        // }
    },

    "hyprland/language" : {
        "format": "{short}",
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    "bluetooth": {
        "format": "\uf294 {status}",
        "format-connected": "\uf294",
        "format-connected-battery": "\uf294{device_battery_percentage:>3}%",
        // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "status-icons": {
             "paused": "⏸"
        },
        "interval": 1,
    },

    "tray": {
        "spacing": 4,
    },

    "clock": {
        "tooltip-format": "<tt>{calendar}</tt>",
        "format": "{:%a %d %b %H:%M:%S}",
        "interval": 1
    },

    "cpu": {
        "format": "{usage:>3}C",
        "interval": 1,
    },

    "memory": {
        "format": "{used:>4.1f}M",
        "interval": 1,
    },

    "network": {
        "format-wifi": "{bandwidthDownBytes:>9}↓ {bandwidthUpBytes:>9}↑ {signalStrength:>3}%",
        "format-ethernet": "",
        "format-linked": "No IP",
        "format-disconnected": "⚠",
        "tooltip": false,
        "interval": 1,
    },

    "pulseaudio": {
        "scroll-step": 1, // %, can be a float
        "format": "{volume:>3}% {format_source}",
        "format-bluetooth": "{volume:>3}% {format_source}",
        "format-bluetooth-muted": " {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume:>3}%",
        "format-source-muted": "{volume:>3}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "format-icons": {
            "default": "⛶",
        },
        "tooltip": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
    },

    "custom/gpu": {
        "format": "{:>3}G",
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "interval": 1
    },
    //
    // "custom/tps": {
    //     "format": "{}",
    //     "exec": "/home/henrikmoellmann/dev/tps/measure_tps.py --status",
    //     "interval": 1,
    // },

    // LAPTOP ------------------------------------------------------------------

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} ",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15,
            "blink": 5
        },
        "format": "{capacity:>3}%",
        "format-full": "󱐋100%",
        "format-charging": "󱐋{capacity:>3}%",
        "format-time": "{H}:{m}",
        "interval": 1,
    },

}
