#!/usr/bin/env python3
"""Open one Anki note in Anki's browser from a strict local URI."""

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ANKI_CONNECT = "http://127.0.0.1:8765"
MAX_NOTE_ID = 9_223_372_036_854_775_807
ID_RE = re.compile(r"[1-9][0-9]*\Z")
NO_NOTIFY = os.environ.get("ANKI_NOTE_NO_NOTIFY") == "1"
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
RESULT_PATH = CACHE_HOME / "anki-note-handler" / "last-result.json"


def atomic_result(payload):
    try:
        RESULT_PATH.parent.mkdir(parents=True, exist_ok=True)
        payload = dict(payload)
        payload["time_ns"] = time.time_ns()
        data = (json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n").encode()
        temp = RESULT_PATH.with_name(f".{RESULT_PATH.name}.{os.getpid()}.tmp")
        with temp.open("xb") as handle:
            os.chmod(temp, 0o600)
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, RESULT_PATH)
    except Exception:
        pass


def notify(message):
    if NO_NOTIFY:
        return
    try:
        subprocess.run(
            ["notify-send", "Anki-Link", message],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
    except Exception:
        pass


def fail(status, message, exit_code, note_id=None):
    payload = {"status": status, "message": message}
    if note_id is not None:
        payload["note_id"] = str(note_id)
    atomic_result(payload)
    notify(message)
    return exit_code


def api(action, params):
    request = urllib.request.Request(
        ANKI_CONNECT,
        data=json.dumps({"action": action, "version": 6, "params": params}).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=4) as response:
        result = json.load(response)
    if not isinstance(result, dict) or "error" not in result or "result" not in result:
        raise RuntimeError("Ungültige AnkiConnect-Antwort")
    if result["error"] is not None:
        raise RuntimeError(str(result["error"]))
    return result["result"]


def parse_note_uri(value):
    parts = urllib.parse.urlsplit(value)
    if (
        parts.scheme != "anki-note"
        or parts.path not in ("", "/")
        or parts.query
        or parts.fragment
        or not ID_RE.fullmatch(parts.netloc)
    ):
        raise ValueError("Ungültiger anki-note-Link")
    note_id = int(parts.netloc)
    if note_id > MAX_NOTE_ID:
        raise ValueError("Anki-Notiz-ID außerhalb des gültigen Bereichs")
    return note_id


def check_api():
    actions = api("apiReflect", {"scopes": ["actions"]})
    if not isinstance(actions, dict) or "guiBrowse" not in actions.get("actions", []):
        raise RuntimeError("AnkiConnect unterstützt guiBrowse nicht")
    payload = {"status": "check_ok", "action": "guiBrowse"}
    atomic_result(payload)
    print(json.dumps(payload, sort_keys=True))
    return 0


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--check":
        try:
            return check_api()
        except (OSError, urllib.error.URLError, RuntimeError, ValueError) as error:
            return fail("check_failed", f"AnkiConnect nicht erreichbar: {error}", 3)

    if len(sys.argv) != 2:
        return fail("invalid_uri", "Genau ein anki-note-Link ist erforderlich", 2)
    try:
        note_id = parse_note_uri(sys.argv[1])
    except ValueError as error:
        return fail("invalid_uri", str(error), 2)

    try:
        cards = api("guiBrowse", {"query": f"nid:{note_id}"})
        if not isinstance(cards, list) or not cards:
            raise RuntimeError("Anki-Notiz nicht gefunden")
    except (OSError, urllib.error.URLError, RuntimeError, ValueError) as error:
        return fail("open_failed", f"Anki-Notiz konnte nicht geöffnet werden: {error}", 4, note_id)

    atomic_result(
        {
            "status": "opened",
            "action": "guiBrowse",
            "note_id": str(note_id),
            "card_count": len(cards),
        }
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
