#!/usr/bin/env bash
# Back up credentials and private config that must never go into the public dotfiles
# into the encrypted borg repo "aspire" on the storage box (reached through the cloud
# host). Runs as the first step of `update`; borg-pull copies the repo to the HDD.
#
# usage: backup-secrets            create a secrets-* archive, then prune and compact
#        backup-secrets --dry-run  only list what would be backed up
#        backup-secrets --list     list the archives
#        backup-secrets --init     create the repository (once), then back up
#
# Passphrase: kept in KeePassXC. To skip typing it, store it once in the GNOME keyring:
#     secret-tool store --label='borg aspire' service borg repo aspire
# Without a keyring entry borg asks for it. The repo uses repokey-blake2, like the
# cloud and forgejo repos, so restoring needs only the passphrase:
#     borg extract ssh://cloud/mnt/storage-box-1/borg-repos/aspire::<archive>
set -euo pipefail

export BORG_REPO=${BORG_REPO:-ssh://cloud/mnt/storage-box-1/borg-repos/aspire}
export BORG_DISPLAY_PASSPHRASE=${BORG_DISPLAY_PASSPHRASE:-no}
# borg-pull mirrors this repo (same repo ID) to the HDD. After that copy was opened, borg
# would otherwise abort here with "repository was previously located at /mnt/external/...".
export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
if [[ -z ${BORG_PASSPHRASE:-} && -z ${BORG_PASSCOMMAND:-} ]] \
    && secret-tool lookup service borg repo aspire >/dev/null 2>&1; then
    export BORG_PASSCOMMAND='secret-tool lookup service borg repo aspire'
fi

# What to back up. Login tokens of CLI tools (gh, claude, codex, gemini) are left out on
# purpose: logging in again is cheap and fewer copies of them is safer. The KeePassXC
# database isn't here either: this repo's passphrase lives inside it.
candidates=(
    ~/.ssh
    ~/.gnupg
    ~/.secrets
    ~/.config/borg/keys
    ~/.config/rclone
    ~/.config/opencode/secrets
    ~/.aws
    ~/.zshrc.local
    /etc/hosts
    /etc/fstab
    /etc/mullvad-vpn/settings.json
)
excludes=(
    --exclude 'sh:**/.gnupg/S.*'
    --exclude 'sh:**/.gnupg/**/.#lk*'
    --exclude 'sh:**/.gnupg/**/*.lock'
    --exclude 'sh:**/.aws/cli/cache'
)

optional=(~/.zshrc.local)

paths=()
for path in "${candidates[@]}"; do
    if [[ -e $path ]]; then
        paths+=("$path")
    elif [[ " ${optional[*]} " != *" $path "* ]]; then
        echo "skipping missing $path"
    fi
done

create() {
    borg create --lock-wait 60 --stats --compression zstd \
        "${excludes[@]}" "$@" "::secrets-{now:%Y-%m-%dT%H:%M:%S}" "${paths[@]}"
}

case ${1:-} in
    --dry-run)
        borg create --dry-run --list "${excludes[@]}" "::secrets-dry-run" "${paths[@]}"
        ;;
    --list)
        borg list --glob-archives 'secrets-*'
        ;;
    --init)
        borg init --encryption repokey-blake2
        echo
        echo "Repository created. Export its key into KeePassXC (next to the passphrase):"
        echo "    borg key export --paper $BORG_REPO"
        echo
        create
        ;;
    "")
        create
        borg prune --lock-wait 60 --glob-archives 'secrets-*' --keep-last 10 --keep-monthly 12
        borg compact --lock-wait 60
        ;;
    *)
        sed -n '6,10p' "$0" >&2
        exit 2
        ;;
esac
